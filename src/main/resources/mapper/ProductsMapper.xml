<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.njhtr.yaopenghao.mapper.ProductsMapper">

    <resultMap id="ProductResultMap" type="com.njhtr.yaopenghao.entity.dto.Product">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="des" property="des" jdbcType="VARCHAR"/>
        <result column="price" property="price" jdbcType="DECIMAL"/>
        <result column="stock" property="stock" jdbcType="INTEGER"/>
        <result column="sales" property="sales" jdbcType="INTEGER"/>
        <result column="images" property="images" jdbcType="VARCHAR"/>
        <result column="category_by" property="categoryBy" jdbcType="VARCHAR"/>
        <result column="create_date" property="createDate" jdbcType="TIMESTAMP"/>
        <result column="update_date" property="updateDate" jdbcType="TIMESTAMP"/>
        <result column="del_flay" property="delFlay" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 根据ID获取商品信息 -->
    <select id="getProductById" resultMap="ProductResultMap">
        SELECT *
        FROM t_yaopenghao_products
        WHERE id = #{id} AND del_flay = '0'
    </select>

    <!-- 获取热门商品（按销量降序） -->
    <select id="findHotProducts" resultMap="ProductResultMap">
        SELECT *
        FROM t_yaopenghao_products
        WHERE del_flay = '0'
        ORDER BY sales DESC
            LIMIT #{limit}
    </select>

    <!-- 获取精选商品（按创建时间降序） -->
    <select id="findFeaturedProducts" resultMap="ProductResultMap">
        SELECT *
        FROM t_yaopenghao_products
        WHERE del_flay = '0'
        ORDER BY create_date DESC
            LIMIT #{limit}
    </select>

    <!-- 分页查询商品 -->
    <select id="findProducts" resultMap="ProductResultMap">
        SELECT *
        FROM t_yaopenghao_products
        WHERE del_flay = '0'
        <if test="category != null and category != ''">
            AND category_by = #{category}
        </if>
        ORDER BY ${orderBy}
    </select>

    <select id="getproductsList" resultMap="ProductResultMap">
        SELECT
            *
        FROM
        t_yaopenghao_products
        <where>
            del_flay != '1'
            <if test="keyword != null and  keyword != ''">
                AND(
                name LIKE CONCAT('%', #{keyword}, '%')
                OR
                des LIKE CONCAT('%', #{keyword}, '%')
                OR
                price LIKE CONCAT('%', #{keyword}, '%')
                OR
                stock LIKE CONCAT('%', #{keyword}, '%')
                OR
                sales LIKE CONCAT('%', #{keyword}, '%')
                OR
                images LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
        </where>
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="getproductsCount" resultType="int">
        SELECT
        COUNT(
        *
        )
        FROM
        t_yaopenghao_products
        <where>
            del_flay != '1'
            <if test="keyword != null and  keyword != ''">
                AND(
                name LIKE CONCAT('%', #{keyword}, '%')
                OR
                des LIKE CONCAT('%', #{keyword}, '%')
                OR
                price LIKE CONCAT('%', #{keyword}, '%')
                OR
                stock LIKE CONCAT('%', #{keyword}, '%')
                OR
                sales LIKE CONCAT('%', #{keyword}, '%')
                OR
                images LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
        </where>
    </select>
</mapper>